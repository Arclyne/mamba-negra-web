---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BgTool from './BgTool.astro';
import SectionTitle from './SectionTitle.astro';
import { negocio } from '../config/negocio';
import { foto, anchos, enOrden } from '../lib/galeria';
import datosCortes from '../content/cortes.json';

// RF-03: galería de cortes (src/content/cortes.json). Los reconocimientos van en "Nosotros".
const PERSPECTIVAS = [
  { id: 'frente', corta: 'Frente', larga: 'Frente' },
  { id: 'izquierdo', corta: 'Izq.', larga: 'Lado izquierdo' },
  { id: 'derecho', corta: 'Der.', larga: 'Lado derecho' },
  { id: 'atras', corta: 'Atrás', larga: 'Atrás' },
] as const;

const SIZES = '(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 400px';

const cortes = await Promise.all(
  enOrden(await getCollection('cortes'), datosCortes).map(async (c) => {
    const vistas = await Promise.all(
      PERSPECTIVAS.map(async (p) => {
        const ruta = c.data.vistas[p.id];
        if (!ruta) return { ...p, img: undefined };
        const original = foto(ruta);
        const img = await getImage({ src: original, widths: anchos(original), sizes: SIZES });
        return { ...p, img };
      }),
    );
    // Se muestra primero la primera perspectiva disponible (en el orden de PERSPECTIVAS).
    const inicial = vistas.find((v) => v.img)!.id;
    return { id: c.id, nombre: c.data.nombre, vistas, inicial };
  }),
);

---

<section class="section" id="trabajo" aria-labelledby="t-trabajo">
  <BgTool tool="scissors" class="bt-trab red" />
  <div class="wrap">
    <div class="sec-head">
      <SectionTitle eyebrow="Cortes" id="t-trabajo">Nuestro trabajo</SectionTitle>
      <a class="btn btn-ghost" href={negocio.instagram.url} target="_blank" rel="noopener">
        <svg class="ico" aria-hidden="true"><use href="#i-ig" /></svg>Ver más en Instagram
      </a>
    </div>

    <div class="cortes">
      {cortes.map((c) => (
        <article class="corte" data-corte>
          <div class="fotos">
            {/* Solo la perspectiva visible se descarga al cargar; las demás, al pulsar (o señalar) su botón. */}
            {c.vistas.filter((v) => v.img).map((v) => {
              const activa = v.id === c.inicial;
              const fuente = activa
                ? { src: v.img!.src, srcset: v.img!.srcSet.attribute }
                : { 'data-src': v.img!.src, 'data-srcset': v.img!.srcSet.attribute };
              return (
                <img
                  {...fuente}
                  sizes={SIZES}
                  width={v.img!.attributes.width}
                  height={v.img!.attributes.height}
                  alt={`${c.nombre}, vista ${v.larga.toLowerCase()}`}
                  loading="lazy"
                  decoding="async"
                  class:list={['foto', { activa }]}
                  data-vista={v.id}
                />
              );
            })}
          </div>
          <div class="info">
            <h3>{c.nombre}</h3>
            <div class="vistas" role="group" aria-label={`Perspectivas de ${c.nombre}`}>
              {c.vistas.map((v) => (
                <button type="button" data-ver={v.id} disabled={!v.img}
                  aria-pressed={v.id === c.inicial ? 'true' : 'false'}
                  aria-label={v.img ? v.larga : `${v.larga} (sin foto)`} title={v.larga}>
                  {v.corta}
                </button>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  // Cambia la foto de un corte según la perspectiva elegida.
  document.querySelectorAll<HTMLElement>('[data-corte]').forEach((corte) => {
    const botones = corte.querySelectorAll<HTMLButtonElement>('[data-ver]');
    const fotos = corte.querySelectorAll<HTMLImageElement>('[data-vista]');
    const cargar = (vista?: string) => {
      const f = Array.from(fotos).find((x) => x.dataset.vista === vista);
      if (!f || !f.dataset.src) return;
      f.srcset = f.dataset.srcset!;
      f.src = f.dataset.src;
      delete f.dataset.src;
      delete f.dataset.srcset;
    };
    botones.forEach((b) => {
      // Adelanta la descarga al señalar el botón, para que el cambio se vea sin espera.
      b.addEventListener('pointerenter', () => cargar(b.dataset.ver));
      b.addEventListener('focus', () => cargar(b.dataset.ver));
      b.addEventListener('click', () => {
        cargar(b.dataset.ver);
        botones.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        fotos.forEach((f) => f.classList.toggle('activa', f.dataset.vista === b.dataset.ver));
      });
    });
  });
</script>

<style>

  /* Cortes */
  .cortes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .corte {
    display: flex; flex-direction: column; border: 1px solid var(--color-line); border-radius: 8px;
    background: var(--color-bg); overflow: hidden; transition: border-color .2s, transform .25s var(--ease), box-shadow .25s;
  }
  .corte:hover { border-color: var(--color-line-2); transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0, 0, 0, .55), 0 0 0 1px rgba(215, 38, 46, .35); }
  .fotos { position: relative; aspect-ratio: 4 / 5; background: var(--color-surface); overflow: hidden; }
  .fotos :global(.foto) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transform: scale(1.03); transition: opacity .35s var(--ease), transform .5s var(--ease);
  }
  .fotos :global(.foto.activa) { opacity: 1; transform: none; }
  .info { flex: 1; display: flex; flex-direction: column; gap: 12px; padding: 16px; }
  h3 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 22px; letter-spacing: .02em; text-transform: uppercase; line-height: 1.05; }
  .vistas { margin-top: auto; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .vistas button {
    min-height: 40px; padding: 0 4px; border: 1px solid var(--color-line-2); border-radius: 4px;
    background: transparent; color: var(--color-body); font-size: 12px; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; cursor: pointer; transition: background .15s, border-color .15s, color .15s;
  }
  .vistas button:hover:not(:disabled) { border-color: var(--color-soft); color: var(--color-fg); }
  .vistas button[aria-pressed="true"] { background: var(--color-red); border-color: var(--color-red); color: #fff; }
  .vistas button:disabled { color: #55555c; border-color: #1f1f23; border-style: dashed; cursor: not-allowed; }

  section :global(.bt-trab) { width: clamp(200px, 20vw, 300px); left: -2%; top: 4%; transform: rotate(-22deg); }

  @media (max-width: 1080px) {
    .cortes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    section :global(.bt-trab) { width: 46vw; left: auto; right: -10%; top: 2%; }
  }
  /* En celular los cortes se deslizan de lado en lugar de apilarse. */
  @media (max-width: 640px) {
    .cortes {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px;
      margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter);
      padding-bottom: 8px; scrollbar-width: none;
    }
    .cortes::-webkit-scrollbar { display: none; }
    .corte { flex: 0 0 82%; scroll-snap-align: start; }
    .corte:hover { transform: none; }
  }
</style>
