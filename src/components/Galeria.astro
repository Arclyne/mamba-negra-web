---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BgTool from './BgTool.astro';
import SectionTitle from './SectionTitle.astro';
import { negocio } from '../config/negocio';
import orden from '../content/galeria.json';

// RF-03: las fotos se guardan en src/assets/galeria/ con el nombre indicado en galeria.json.
// Astro genera versiones WebP de varios tamaños y las carga de forma diferida.
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/galeria/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const porNombre = new Map(Object.entries(fotos).map(([ruta, mod]) => [ruta.split('/').pop()!, mod.default]));

// Se respeta el orden de galeria.json (la foto "grande" va primero, la "ancha" al final).
const posicion = new Map(orden.map((g, i) => [g.id, i]));
const entradas = (await getCollection('galeria')).sort((a, b) => posicion.get(a.id)! - posicion.get(b.id)!);
const items = entradas.map((g) => {
  const img = g.data.archivo ? porNombre.get(g.data.archivo) : undefined;
  if (g.data.archivo && !img) throw new Error(`galeria.json: no existe src/assets/galeria/${g.data.archivo}`);
  return { ...g.data, id: g.id, img };
});
const anchos = (img: ImageMetadata) => {
  const w = [320, 640, 960, 1280].filter((n) => n <= img.width);
  return w.length ? w : [img.width];
};
const sizes = {
  grande: '(max-width: 900px) 100vw, 640px',
  ancho: '(max-width: 1280px) 100vw, 1280px',
  normal: '(max-width: 900px) 50vw, 310px',
};
---

<section class="section" id="trabajo" aria-labelledby="t-trabajo">
  <BgTool tool="scissors" class="bt-trab red" />
  <div class="wrap">
    <div class="sec-head">
      <SectionTitle eyebrow="Trayectoria" id="t-trabajo">Nuestro trabajo</SectionTitle>
      <a class="btn btn-ghost" href={negocio.instagram.url} target="_blank" rel="noopener">
        <svg class="ico" aria-hidden="true"><use href="#i-ig" /></svg>Ver más en Instagram
      </a>
    </div>
    <div class="gal">
      {items.map((it) => (
        <figure class:list={[{ 'g-big': it.tamano === 'grande', 'g-wide': it.tamano === 'ancho' }]}>
          {it.img ? (
            <Image class="ph" src={it.img} alt={it.alt ?? `${it.tipo}: ${it.titulo}`}
              widths={anchos(it.img)} sizes={sizes[it.tamano]} />
          ) : (
            <div class="ph ph-empty" role="img" aria-label={`Foto pendiente: ${it.titulo}`}>Foto pendiente</div>
          )}
          <figcaption><b>{it.tipo}</b><span>{it.titulo}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gal { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 240px; gap: 16px; }
  figure { margin: 0; display: flex; flex-direction: column; gap: 12px; min-height: 0; }
  .gal :global(.ph) {
    flex: 1; min-height: 0; width: 100%; object-fit: cover; border-radius: 8px; border: 1px solid var(--color-line);
    transition: border-color .25s, transform .35s var(--ease);
  }
  .gal .ph-empty {
    border-style: dashed; border-color: #48484f;
    background: repeating-linear-gradient(135deg, #101012 0 14px, #141416 14px 28px);
    display: flex; align-items: center; justify-content: center;
    color: var(--color-muted); font-size: 12px; letter-spacing: .18em; text-transform: uppercase;
  }
  figure:hover :global(.ph) { border-color: var(--color-red); transform: scale(1.015); }
  figcaption { display: flex; flex-direction: column; gap: 2px; }
  figcaption b { font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-red-text); }
  figcaption span { font-size: 16px; font-weight: 500; color: #e4e4e8; }
  .g-big { grid-column: span 2; grid-row: span 2; }
  .g-wide { grid-column: span 4; }
  section :global(.bt-trab) { width: clamp(200px, 20vw, 300px); left: -2%; top: 4%; transform: rotate(-22deg); }

  @media (max-width: 900px) {
    .gal { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 190px; gap: 12px; }
    .g-wide { grid-column: span 2; }
    section :global(.bt-trab) { width: 46vw; left: auto; right: -10%; top: 2%; }
  }
  @media (max-width: 640px) {
    .gal { grid-auto-rows: auto; }
    .gal :global(.ph) { flex: none; aspect-ratio: 1 / 1; }
    .g-wide :global(.ph) { aspect-ratio: 2 / 1; }
  }
</style>
