---
import { Image } from 'astro:assets';
import logo from '../assets/logo-192.webp';
import { negocio, waLink } from '../config/negocio';

interface Props { inicio?: string }
const { inicio = '' } = Astro.props;
const anio = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="fb">
      <Image src={logo} alt="" width={44} height={44} densities={[1, 2]} />
      <div><b>{negocio.nombre}</b>{negocio.lema}</div>
    </div>
    <nav aria-label="Legal">
      <a href="/aviso-de-privacidad">Aviso de privacidad</a>
      <span>© {anio} {negocio.nombreLegal} · {negocio.direccion.ciudad}, {negocio.direccion.estadoCorto}</span>
    </nav>
  </div>
</footer>

<!-- RF-08: WhatsApp flotante en escritorio; barra fija con reserva + WhatsApp en móvil -->
<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg width="30" height="30" aria-hidden="true"><use href="#i-wa" /></svg>
</a>
<div class="mbar">
  <a class="btn btn-red" href={`${inicio}#reservar`}>Reservar cita</a>
  <a class="wa" href={waLink()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
    <svg width="24" height="24" aria-hidden="true"><use href="#i-wa" /></svg>
  </a>
</div>

<style>
  footer { border-top: 1px solid var(--color-line); }
  footer .wrap {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px;
    padding-block: 40px; font-size: 15px; color: var(--color-muted);
  }
  .fb { display: flex; align-items: center; gap: 14px; }
  .fb :global(img) { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--color-line-2); }
  .fb b { display: block; font-family: var(--font-display); font-weight: 400; font-size: 23px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-fg); line-height: 1; }
  nav { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; }
  nav a { color: var(--color-body); text-decoration: underline; text-underline-offset: 3px; }

  .wa-float {
    position: fixed; right: 28px; bottom: calc(28px + env(safe-area-inset-bottom, 0px)); z-index: 15;
    width: 62px; height: 62px; border-radius: 50%; background: var(--color-wa); color: #fff;
    display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 28px rgba(0, 0, 0, .6);
    transition: transform .2s var(--ease);
  }
  .wa-float:hover { color: #fff; transform: translateY(-3px) scale(1.05); }
  .mbar { display: none; }

  @media (max-width: 900px) {
    .wa-float { display: none; }
    .mbar {
      display: flex; gap: 10px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 15;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
      background: rgba(0, 0, 0, .95); border-top: 1px solid var(--color-line-2);
    }
    .mbar .btn { flex: 1; }
    .mbar .wa {
      width: 52px; min-height: 52px; border-radius: 4px; background: var(--color-wa); color: #fff;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    footer .wrap { padding-bottom: 110px; }
  }
</style>
