---
import { Image } from 'astro:assets';
import BgTool from './BgTool.astro';
import logo from '../assets/logo.webp';
import { negocio } from '../config/negocio';
---

<div class="hero" id="inicio">
  <BgTool tool="razor" class="bt-hero" />
  <div class="wrap">
    <div>
      <p class="eyebrow">Barbería premium · Centro de {negocio.direccion.ciudad}</p>
      <h1 class="display"><span class="ln">La Mamba</span><br /><span class="ln red">Negra</span></h1>
      <p class="lead">Donde el estilo clásico se fusiona con la cultura contemporánea. Cada corte, una obra maestra.</p>
      <div class="cta">
        <a class="btn btn-red" href="#reservar">Reservar cita</a>
        <a class="btn btn-ghost" href="#servicios">Ver precios</a>
      </div>
      <div class="facts">
        <span><svg class="ico" aria-hidden="true"><use href="#i-clock" /></svg>{negocio.horario.resumen}</span>
        <span><svg class="ico" aria-hidden="true"><use href="#i-pin" /></svg>{negocio.direccion.calle}, {negocio.direccion.colonia}</span>
      </div>
    </div>

    <div class="hero-logo">
      <div class="turntable" id="turntable">
        <div class="disc">
          <div class="label">
            <Image
              src={logo}
              widths={[320, 480, 720]}
              sizes="(max-width: 900px) 56vw, 320px"
              loading="eager"
              fetchpriority="high"
              alt="Logotipo de La Mamba Negra Barbería: una cobra cromada sobre el nombre en letra gótica roja y plateada, al centro de un disco de vinilo"
            />
          </div>
          <div class="spindle"></div>
        </div>
        <div class="sheen" aria-hidden="true"></div>
        <svg class="arm" viewBox="0 0 100 100" aria-hidden="true">
          <rect x="84" y="-2" width="18" height="18" rx="3" fill="#121214" stroke="#2e2e33" stroke-width=".6" />
          <circle cx="93" cy="7" r="7" fill="#1b1b1e" stroke="#4a4a52" stroke-width=".8" />
          <circle cx="93" cy="7" r="4.6" fill="#0c0c0e" />
          <circle cx="99.5" cy="42" r="2.2" fill="#1b1b1e" stroke="#4a4a52" stroke-width=".6" />
          <g class="rot">
            <rect x="94.2" y="-7.5" width="5.2" height="7" rx="1.4" fill="#3a3a40" stroke="#6c6c74" stroke-width=".4" transform="rotate(8 96.8 -4)" />
            <path d="M96 -3 L93 7" fill="none" stroke="#b9b9c1" stroke-width="1.3" stroke-linecap="round" />
            <path d="M93 7 L88 44 L80 69" fill="none" stroke="#d9d9de" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M93 7 L88 44 L80 69" fill="none" stroke="#7a7a82" stroke-width=".5" stroke-linecap="round" stroke-linejoin="round" transform="translate(.5 .3)" />
            <rect x="76.5" y="67" width="7" height="9" rx="1.2" fill="#D7262E" transform="rotate(20 80 71)" />
            <circle cx="93" cy="7" r="2.8" fill="#c9c9cf" />
          </g>
        </svg>
        <button type="button" class="spin-toggle" id="spinBtn" aria-pressed="false" aria-label="Pausar el disco">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <g class="i-pause"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></g>
            <path class="i-play" d="M8 5v14l11-7z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const tt = document.getElementById('turntable')!;
  const btn = document.getElementById('spinBtn')!;
  btn.addEventListener('click', () => {
    const paused = tt.classList.toggle('paused');
    tt.classList.toggle('resumed', !paused);
    btn.setAttribute('aria-pressed', String(paused));
    btn.setAttribute('aria-label', paused ? 'Reanudar el disco' : 'Pausar el disco');
  });
</script>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero > .wrap {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px; align-items: center;
    padding-block: clamp(40px, 7vw, 96px);
  }
  h1 { font-size: clamp(96px, 12vw, 176px); line-height: .84; margin: 26px 0 28px; }
  h1 .ln.red { color: var(--color-red-hot); }
  .lead { font-size: clamp(18px, 1.6vw, 21px); color: var(--color-body); max-width: 30em; margin: 0 0 32px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .facts { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 32px; font-size: 15px; color: var(--color-body); }
  .facts span { display: flex; align-items: center; gap: 10px; }
  .facts .ico { stroke: var(--color-red-text); }

  /* Entrada al cargar (solo CSS) */
  .eyebrow, h1 .ln, .lead, .cta, .facts { animation: rise .8s var(--ease) both; }
  .eyebrow { animation-delay: .05s; }
  .eyebrow::before { transform-origin: left; animation: lineIn .6s var(--ease) .35s both; }
  h1 .ln { display: inline-block; }
  h1 .ln:nth-of-type(1) { animation-delay: .15s; }
  h1 .ln:nth-of-type(2) { animation-delay: .28s; }
  .lead { animation-delay: .42s; }
  .cta { animation-delay: .54s; }
  .facts { animation-delay: .66s; }
  /* "Skin fade": cada línea del título se desvanece hacia abajo, como un degradado de corte */
  h1 .ln {
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, .28) 2%, rgba(0, 0, 0, .7) 22%, #000 52%);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, .28) 2%, rgba(0, 0, 0, .7) 22%, #000 52%);
  }

  .hero-logo { position: relative; display: flex; justify-content: center; align-items: center; }
  .hero-logo::before {
    content: ""; position: absolute; width: min(100%, 540px); aspect-ratio: 1; border-radius: 50%;
    border: 1px solid var(--color-line); box-shadow: 0 0 120px 10px rgba(215, 38, 46, .10);
    animation: glowIn 1s var(--ease) .2s both, breathe 6s ease-in-out 1.4s infinite;
  }

  /* Disco de vinilo */
  .turntable { position: relative; width: min(92%, 480px); aspect-ratio: 1; animation: logoIn 1.1s var(--ease) .25s both; }
  .disc {
    position: absolute; inset: 0; border-radius: 50%;
    background:
      repeating-radial-gradient(circle, #0a0a0b 0 1.6px, #17171a 1.6px 2.4px, #0d0d0f 2.4px 3.4px),
      #0b0b0c;
    box-shadow: 0 0 0 1px #2a2a2e inset, 0 0 0 6px #050505, 0 30px 70px rgba(0, 0, 0, .8);
    animation: spin 3.6s linear 1.9s infinite;
  }
  .disc::before {
    content: ""; position: absolute; inset: 3.5%; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, .05); box-shadow: inset 0 0 0 18px rgba(0, 0, 0, .25);
  }
  .label {
    position: absolute; inset: 18%; border-radius: 50%; overflow: hidden; background: #000;
    box-shadow: 0 0 0 3px var(--color-red), 0 0 0 6px #000, 0 0 0 7px #2a2a2e;
  }
  .label :global(img) { width: 100%; height: 100%; object-fit: contain; transform: scale(1.02); }
  .spindle {
    position: absolute; left: 50%; top: 50%; width: 3.2%; aspect-ratio: 1; margin: -1.6% 0 0 -1.6%; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #e9e9ee, #8a8a92 55%, #3a3a40); box-shadow: 0 0 0 2px #000;
  }
  .sheen {
    position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
    background: conic-gradient(from 20deg, transparent 0 6%, rgba(255, 255, 255, .10) 11%, transparent 17%, transparent 50%, rgba(255, 255, 255, .07) 61%, transparent 67%);
    -webkit-mask: radial-gradient(circle, transparent 0 33%, #000 33.5%);
    mask: radial-gradient(circle, transparent 0 33%, #000 33.5%);
  }
  .arm { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; filter: drop-shadow(0 8px 10px rgba(0, 0, 0, .7)); }
  .arm .rot { transform-box: view-box; transform-origin: 93px 7px; transform: rotate(-30deg); animation: armIn 1.1s var(--ease) 1s forwards; }
  .turntable.paused .disc { animation-play-state: paused; }
  .turntable.paused .arm .rot { transform: rotate(-30deg); animation: none; transition: transform .7s var(--ease); }
  .turntable.resumed .arm .rot { animation: none; transform: rotate(0deg); transition: transform .7s var(--ease); }

  .spin-toggle {
    position: absolute; left: 0; bottom: 2%; width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--color-line-2); background: rgba(0, 0, 0, .7); color: var(--color-fg);
    display: flex; align-items: center; justify-content: center; cursor: pointer; transition: border-color .2s, transform .2s;
  }
  .spin-toggle:hover { border-color: var(--color-red); transform: scale(1.06); }
  .spin-toggle .i-play, .spin-toggle[aria-pressed="true"] .i-pause { display: none; }
  .spin-toggle[aria-pressed="true"] .i-play { display: inline; }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes armIn { from { transform: rotate(-30deg); } to { transform: rotate(0deg); } }
  @keyframes logoIn { from { opacity: 0; transform: scale(.86) rotate(-3deg); } to { opacity: 1; transform: none; } }
  @keyframes glowIn { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: none; } }
  @keyframes breathe {
    0%, 100% { box-shadow: 0 0 90px 0 rgba(215, 38, 46, .10); }
    50% { box-shadow: 0 0 150px 24px rgba(215, 38, 46, .24); }
  }

  .hero :global(.bt-hero) { width: clamp(320px, 40vw, 640px); left: -4%; bottom: 6%; transform: rotate(-14deg); }

  @media (max-width: 900px) {
    .hero > .wrap { grid-template-columns: 1fr; gap: 8px; }
    .hero-logo { order: 2; }
    .turntable { width: min(84%, 360px); }
    .hero-logo::before { width: min(92%, 400px); }
    .hero :global(.bt-hero) { width: 88vw; left: -20%; bottom: auto; top: 30%; }
  }
  @media (max-width: 640px) {
    h1 { font-size: clamp(84px, 26vw, 112px); }
    .cta .btn { flex: 1; padding: 0 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .disc, .arm .rot { animation: none !important; }
    .arm .rot { transform: none; }
    .spin-toggle { display: none; }
  }
</style>
