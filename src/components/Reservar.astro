---
import { getServicios, duracionTexto } from '../lib/servicios';
import BgTool from './BgTool.astro';
import SectionTitle from './SectionTitle.astro';
import { negocio, waLink } from '../config/negocio';

const servicios = await getServicios();
const grupos = [
  { etiqueta: 'Servicios', items: servicios.filter((s) => s.data.categoria === 'servicio') },
  { etiqueta: 'Combos', items: servicios.filter((s) => s.data.categoria === 'combo') },
];
const inicial = servicios[0];

// Con la cuenta de Cal.com del negocio configurada se muestra el calendario real (RF-04).
// Sin ella, la reserva se hace por WhatsApp con el servicio ya escrito en el mensaje.
const { usuario, origen } = negocio.calcom;
const conCal = usuario.trim() !== '';
const calLink = (id: string, evento?: string) => `${usuario}/${evento ?? id}`;
const mensajeWa = (nombre: string, precio: number) => `Hola, quiero agendar una cita para: ${nombre} ($${precio} MXN).`;
---

<section class="section alt" id="reservar" aria-labelledby="t-reservar">
  <BgTool tool="razor" class="bt-book" />
  <div class="wrap">
    <div class="sec-head">
      <SectionTitle eyebrow="Agenda tu visita" id="t-reservar">Reservar cita</SectionTitle>
      <p class="intro">
        {conCal
          ? 'Elige servicio, día y hora. Te llega la confirmación por correo y un recordatorio un día antes.'
          : 'Elige tu servicio y escríbenos por WhatsApp para confirmar día y hora.'}
      </p>
    </div>

    <div class="book" id="booking" data-reservas-cal={conCal ? '' : undefined} data-origen={origen} data-wa={waLink()}>
      <div class="b-svc">
        <span class="step" id="lbl-svc">1 · Servicio</span>
        <div class="svc-list" role="group" aria-labelledby="lbl-svc">
          {grupos.map((g) => (
            <>
              <span class="grp">{g.etiqueta}</span>
              {g.items.map((s) => (
                <button type="button" data-svc={s.id} data-nombre={s.data.nombre} data-precio={s.data.precio}
                  data-duracion={duracionTexto(s.data.duracion)} data-evento={calLink(s.id, s.data.calEvento)}
                  aria-pressed={s.id === inicial.id ? 'true' : 'false'}>
                  <span>{s.data.nombre}</span><em>${s.data.precio}</em>
                </button>
              ))}
            </>
          ))}
        </div>
        <div class="svc-select">
          <label class="step" for="svcSelect">1 · Servicio</label>
          <select id="svcSelect">
            {grupos.map((g) => (
              <optgroup label={g.etiqueta}>
                {g.items.map((s) => <option value={s.id} selected={s.id === inicial.id}>{s.data.nombre} — ${s.data.precio}</option>)}
              </optgroup>
            ))}
          </select>
        </div>
        <div class="summary" aria-live="polite">
          <strong id="sumSvc">{inicial.data.nombre}</strong>
          <span><span id="sumDur">{duracionTexto(inicial.data.duracion)}</span> · <span class="p" id="sumPrice">${inicial.data.precio} MXN</span></span>
        </div>
      </div>

      <div class="b-cal">
        {conCal ? (
          <>
            <span class="step">2 · Día y hora</span>
            <div class="cal-embed" id="calEmbed">
              <p class="cal-loading" id="calLoading">Cargando horarios disponibles…</p>
            </div>
            <noscript>
              <p class="fallback-note">
                Para ver los horarios, abre <a href={`https://cal.com/${calLink(inicial.id, inicial.data.calEvento)}`}>nuestra agenda en Cal.com</a>
                {' '}o escríbenos por <a href={waLink(mensajeWa(inicial.data.nombre, inicial.data.precio))}>WhatsApp</a>.
              </p>
            </noscript>
          </>
        ) : (
          <div class="wa-box">
            <span class="step">2 · Confirma por WhatsApp</span>
            <p>Te respondemos con los horarios disponibles para <strong id="waSvc">{inicial.data.nombre}</strong>.</p>
            <a class="btn btn-red" id="waBtn" href={waLink(mensajeWa(inicial.data.nombre, inicial.data.precio))} target="_blank" rel="noopener">
              <svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>Agendar por WhatsApp
            </a>
            <p class="hours-note">{negocio.horario.resumen} · Domingos cerrado</p>
          </div>
        )}
      </div>
    </div>

    {conCal && (
      <div class="rules">
        <span><svg class="ico" aria-hidden="true"><use href="#i-clock" /></svg>Reserva hasta 30 min antes</span>
        <span><svg class="ico" aria-hidden="true"><use href="#i-undo" /></svg>Cancela o cambia hasta 1 h antes, desde tu correo</span>
        <span><svg class="ico" aria-hidden="true"><use href="#i-mail" /></svg>Confirmación y recordatorio por correo</span>
      </div>
    )}
  </div>
</section>

<script>
  import { montarCalendario } from '../scripts/calcom';

  const root = document.getElementById('booking')!;
  // Ojo: no usar atributos data-cal-*, el script de Cal.com los convierte en botones de ventana emergente.
  const conCal = root.hasAttribute('data-reservas-cal');
  const origin = root.dataset.origen!;
  const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-svc]'));
  const select = document.getElementById('svcSelect') as HTMLSelectElement;
  const embed = document.getElementById('calEmbed');
  const montados = new Map<string, HTMLElement>();
  let actual = buttons.find((b) => b.getAttribute('aria-pressed') === 'true')!.dataset.svc!;
  let activo = false; // el calendario se carga solo cuando hace falta

  const $ = (id: string) => document.getElementById(id);
  const datos = (id: string) => buttons.find((b) => b.dataset.svc === id)?.dataset;

  function mostrarCalendario() {
    if (!conCal || !embed || !activo) return;
    const d = datos(actual)!;
    montados.forEach((el, id) => { el.hidden = id !== actual; });
    if (montados.has(actual)) return;
    const el = document.createElement('div');
    el.className = 'cal-frame';
    embed.appendChild(el);
    montados.set(actual, el);
    montarCalendario(el, { origin, calLink: d.evento!, namespace: `svc_${actual.replace(/-/g, '_')}` });
    // Cal.com inserta su iframe; entonces se quita el aviso de carga.
    new MutationObserver((_, obs) => {
      if (el.querySelector('iframe')) { $('calLoading')?.remove(); obs.disconnect(); }
    }).observe(el, { childList: true, subtree: true });
  }

  function elegir(id: string) {
    const d = datos(id);
    if (!d) return;
    actual = id;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.svc === id)));
    select.value = id;
    $('sumSvc')!.textContent = d.nombre!;
    $('sumDur')!.textContent = d.duracion!;
    $('sumPrice')!.textContent = `$${d.precio} MXN`;
    const sum = root.querySelector('.summary')!;
    sum.classList.remove('flash'); void (sum as HTMLElement).offsetWidth; sum.classList.add('flash');
    if (conCal) {
      activo = true;
      mostrarCalendario();
    } else {
      $('waSvc')!.textContent = d.nombre!;
      const msg = `Hola, quiero agendar una cita para: ${d.nombre} ($${d.precio} MXN).`;
      ($('waBtn') as HTMLAnchorElement).href = `${root.dataset.wa}?text=${encodeURIComponent(msg)}`;
    }
  }

  buttons.forEach((b) => b.addEventListener('click', () => elegir(b.dataset.svc!)));
  select.addEventListener('change', () => elegir(select.value));
  // Botón "Reservar" de una tarjeta de servicio.
  window.addEventListener('mamba:servicio', (e) => elegir((e as CustomEvent<string>).detail));
  // Enlace directo con servicio: /?servicio=permacologia#reservar (útil para Instagram).
  const deUrl = new URLSearchParams(location.search).get('servicio');
  if (deUrl && datos(deUrl)) elegir(deUrl);

  // Carga diferida: el calendario se monta cuando la sección está por entrar en pantalla.
  if (conCal) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((en) => en.isIntersecting)) { activo = true; mostrarCalendario(); io.disconnect(); }
    }, { rootMargin: '400px 0px' });
    io.observe(root);
  }
</script>

<style>
  .intro { margin: 0; max-width: 28em; color: var(--color-body); }
  .book {
    display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    border: 1px solid var(--color-line-2); border-radius: 10px; background: var(--color-bg); overflow: hidden;
  }
  .book > div { padding: 28px; }
  .book > div + div { border-left: 1px solid var(--color-line); }
  .step { font-size: 13px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--color-muted); margin: 0 0 14px; display: block; }
  .grp { display: block; margin: 10px 14px 4px; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--color-muted); }
  .grp:first-child { margin-top: 0; }

  .svc-list { display: flex; flex-direction: column; gap: 4px; }
  .svc-list button {
    min-height: 44px; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 0 14px;
    border: 1px solid transparent; border-radius: 6px; background: transparent; text-align: left;
    font-size: 15px; font-weight: 500; cursor: pointer; color: var(--color-fg);
    transition: background .15s, border-color .15s, transform .15s;
  }
  .svc-list button:hover { background: var(--color-surface); }
  .svc-list button[aria-pressed="true"] { border-color: var(--color-red); background: var(--color-red-dim); font-weight: 700; }
  .svc-list em { font-style: normal; font-family: var(--font-display); font-size: 22px; letter-spacing: .03em; }
  .svc-select { display: none; }
  .svc-select select {
    width: 100%; min-height: 52px; padding: 0 14px; border-radius: 6px; border: 1px solid var(--color-red);
    background: var(--color-red-dim); color: var(--color-fg); font-size: 16px; font-weight: 600;
  }

  .summary {
    margin-top: 18px; padding: 16px; border-radius: 6px; background: var(--color-surface); border: 1px solid var(--color-line-2);
    display: flex; flex-direction: column; gap: 2px; font-size: 15px; color: var(--color-body);
  }
  .summary strong { color: var(--color-fg); font-size: 16px; }
  .summary .p { color: var(--color-fg); font-weight: 600; }
  .summary.flash { animation: flash .8s ease-out; }
  @keyframes flash { 0% { background: #3a1114; border-color: var(--color-red); } 100% { background: var(--color-surface); border-color: var(--color-line-2); } }

  .cal-embed { position: relative; min-height: 560px; }
  .cal-embed :global(.cal-frame) { width: 100%; }
  .cal-loading {
    position: absolute; inset: 0; margin: 0; display: flex; align-items: center; justify-content: center;
    color: var(--color-muted); font-size: 15px;
  }
  .fallback-note { margin: 0; color: var(--color-body); }

  .wa-box { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; max-width: 30em; }
  .wa-box p { margin: 0; color: var(--color-body); font-size: 17px; }
  .wa-box strong { color: var(--color-fg); }
  .wa-box .hours-note { font-size: 15px; color: var(--color-soft); }

  .rules { display: flex; flex-wrap: wrap; gap: 12px 40px; margin-top: 28px; font-size: 16px; color: var(--color-body); }
  .rules span { display: flex; align-items: center; gap: 10px; }
  .rules .ico { stroke: var(--color-red-text); }

  section :global(.bt-book) { width: clamp(320px, 36vw, 560px); right: -6%; bottom: 4%; transform: rotate(168deg); }

  @media (max-width: 900px) {
    .book { grid-template-columns: 1fr; }
    .book > div + div { border-left: 0; border-top: 1px solid var(--color-line); }
    .svc-list, .b-svc > .step { display: none; }
    .svc-select { display: block; }
    section :global(.bt-book) { width: 90vw; right: -30%; bottom: auto; top: 4%; }
  }
  @media (max-width: 640px) {
    .book > div { padding: 20px; }
    .b-cal:has(.cal-embed) { padding-inline: 4px; }
    .b-cal:has(.cal-embed) .step { padding-inline: 16px; }
    .rules { flex-direction: column; gap: 12px; }
  }
</style>
