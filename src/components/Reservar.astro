---
// Pasos 2 y 3 de la reserva. Vive dentro de la sección de servicios (Servicios.astro), cuyas tarjetas son el paso 1.
//  · Paso 2 (día y hora): calendario propio con el diseño del sitio. Los horarios son los reales,
//    de la API pública de Cal.com (src/scripts/horarios.ts).
//  · Paso 3 (tus datos): formulario propio que crea la reserva con la API pública de Cal.com
//    (src/scripts/reserva.ts). Cal.com guarda la cita y manda confirmación, recordatorio y enlaces
//    para cambiar o cancelar; el sitio no guarda datos personales.
//  · Si la API falla, se muestra el calendario completo de Cal.com como respaldo.
import { negocio, waLink } from '../config/negocio';

// Con la cuenta de Cal.com del negocio configurada se reserva en línea (RF-04).
// Sin ella, la reserva se hace por WhatsApp con el servicio ya escrito en el mensaje.
const { usuario, origen } = negocio.calcom;
const conCal = usuario.trim() !== '';
const diasSemana = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
---

<!-- Ojo: no usar atributos data-cal-*, el script de Cal.com los convierte en botones de ventana emergente. -->
<div class="book" id="booking" hidden data-reservas-cal={conCal ? '' : undefined} data-origen={origen} data-wa={waLink()}>
  <div class="elegido">
    <div class="elegido-txt">
      <h3 class="step" id="paso2-t" tabindex="-1">{conCal ? 'Elige día y hora' : 'Confirma por WhatsApp'}</h3>
      <strong id="sumSvc"></strong>
      <span><span id="sumDur"></span> · <span class="p" id="sumPrice"></span></span>
    </div>
    <div class="acciones">
      {conCal && (
        <button type="button" class="btn btn-ghost" id="reiniciar" hidden>
          <svg class="ico" aria-hidden="true"><use href="#i-clock" /></svg><span id="reiniciarTxt">Cambiar horario</span>
        </button>
      )}
      <button type="button" class="btn btn-ghost cambiar" id="cambiar">
        <span aria-hidden="true">←</span> Cambiar servicio
      </button>
    </div>
    {conCal && (
      <ul class="rules" aria-label="Condiciones de la reserva">
        <li><svg class="ico" aria-hidden="true"><use href="#i-clock" /></svg>Reserva hasta 30 min antes</li>
        <li><svg class="ico" aria-hidden="true"><use href="#i-undo" /></svg>Si necesitas cancelar o cambiar, avísanos con 1 h de anticipación desde tu correo</li>
        <li><svg class="ico" aria-hidden="true"><use href="#i-mail" /></svg>Confirmación y recordatorio por correo</li>
      </ul>
    )}
  </div>

  {conCal ? (
    <>
      <!-- Paso 2: día y hora -->
      <div class="agenda" id="agenda">
        <div class="b-cal">
          <div class="cal-head">
            <span class="step" id="lbl-dia">Día</span>
            <div class="cal-nav">
              <button type="button" id="mesAnt" aria-label="Mes anterior">‹</button>
              <span id="mesLbl" aria-live="polite"></span>
              <button type="button" id="mesSig" aria-label="Mes siguiente">›</button>
            </div>
          </div>
          <div class="dow" aria-hidden="true">{diasSemana.map((d) => <span>{d}</span>)}</div>
          <div class="days" id="dias" role="group" aria-labelledby="lbl-dia"></div>
          <p class="cal-foot">Domingos cerrado · Reserva hasta 30 min antes · Hora de Coatepec</p>
        </div>
        <div class="b-time">
          <span class="step" id="lbl-hora">Hora</span>
          <div class="slots" id="horas" role="group" aria-labelledby="lbl-hora"></div>
          <p class="aviso" id="horasAviso" aria-live="polite"></p>
          <div class="summary" aria-live="polite">
            <strong id="resSvc"></strong>
            <span id="resCuando">Elige un día y una hora</span>
            <span><span id="resDur"></span> · <span class="p" id="resPrecio"></span></span>
          </div>
          <button type="button" class="btn btn-red continuar" id="continuar" disabled>Continuar</button>
        </div>
      </div>

      <!-- Paso 3: tus datos -->
      <form class="datos" id="datos" hidden novalidate>
        <div class="d-res" aria-live="polite">
          <strong id="dSvc"></strong>
          <span id="dCuando"></span>
          <span><span id="dDur"></span> · <span class="p" id="dPrecio"></span></span>
        </div>
        <div class="campos">
          <label class="campo">
            <span>Nombre <b aria-hidden="true">*</b></span>
            <input id="fNombre" name="nombre" type="text" autocomplete="name" required maxlength="80" />
          </label>
          <label class="campo">
            <span>Correo electrónico <b aria-hidden="true">*</b></span>
            <input id="fCorreo" name="correo" type="email" autocomplete="email" inputmode="email" required maxlength="120" />
            <small>Ahí te llegan la confirmación, el recordatorio y los enlaces para cambiar o cancelar.</small>
          </label>
          <label class="campo">
            <span>WhatsApp <em>(opcional)</em></span>
            <span class="tel"><span class="lada" aria-hidden="true">+52</span>
              <input id="fTel" name="telefono" type="tel" autocomplete="tel-national" inputmode="numeric" maxlength="14" placeholder="228 123 4567" aria-describedby="telAyuda" />
            </span>
            <small id="telAyuda">10 dígitos. Solo para avisarte si hay algún cambio.</small>
          </label>
          <label class="campo">
            <span>Notas para el barbero <em>(opcional)</em></span>
            <textarea id="fNotas" name="notas" rows="3" maxlength="500" placeholder="Ej.: quiero un fade bajo, traigo foto de referencia…"></textarea>
          </label>
          <!-- Trampa para bots: invisible para las personas. -->
          <input class="trampa" id="fSitio" name="sitio" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </div>
        <p class="error" id="fError" role="alert" hidden></p>
        <p class="legal">Al confirmar aceptas nuestro <a href="/aviso-de-privacidad" target="_blank">aviso de privacidad</a>. La reserva la gestiona Cal.com.</p>
        <button type="submit" class="btn btn-red confirmar" id="confirmar">Confirmar reserva</button>
      </form>

      <!-- Reserva confirmada -->
      <div class="exito" id="exito" hidden tabindex="-1">
        <div class="check" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg></div>
        <h4 id="eTitulo">¡Listo, tu cita quedó reservada!</h4>
        <p class="e-cuando" id="eCuando"></p>
        <p id="eCorreo"></p>
        <p class="e-dir">{negocio.direccion.calle}, {negocio.direccion.colonia}, {negocio.direccion.ciudad}</p>
        <button type="button" class="btn btn-red" id="otra">Hacer otra reserva</button>
      </div>

      <!-- Respaldo: calendario completo de Cal.com si la API no responde -->
      <div class="cal-embed" id="calEmbed" hidden></div>
    </>
  ) : (
    <div class="wa-box">
      <p>Te respondemos con los horarios disponibles para <strong id="waSvc"></strong>.</p>
      <a class="btn btn-red" id="waBtn" href={waLink()} target="_blank" rel="noopener">
        <svg class="ico" aria-hidden="true"><use href="#i-wa" /></svg>Agendar por WhatsApp
      </a>
      <p class="hours-note">{negocio.horario.resumen} · Domingos cerrado</p>
    </div>
  )}
</div>

<script>
  import { montarCalendario } from '../scripts/calcom';
  import { horariosDelMes, olvidar, hoy, mesSiguiente, horaLocal, type Horarios } from '../scripts/horarios';
  import { crearReserva } from '../scripts/reserva';

  const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
  const MESES_ADELANTE = 2; // hasta cuántos meses después del actual se puede navegar

  const book = document.getElementById('booking')!;
  const paso1 = document.getElementById('paso1')!;
  const conCal = book.hasAttribute('data-reservas-cal');
  const origin = book.dataset.origen!;
  const picks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-pick]'));
  const agenda = document.getElementById('agenda');
  const embed = document.getElementById('calEmbed');
  const $ = (id: string) => document.getElementById(id)!;
  const datos = (id: string) => picks.find((a) => a.dataset.pick === id)?.dataset;
  const suave = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');

  // Estado de la reserva en curso.
  let actual = '';
  let mes = '';                          // AAAA-MM que se muestra
  let horarios: Horarios = {};           // del mes mostrado
  let dia: string | null = null;         // AAAA-MM-DD elegido
  let hora: string | null = null;        // instante ISO elegido
  let peticion = 0;                      // para ignorar respuestas viejas
  let montajes = 0;

  const fecha = (d: string) => new Date(`${d}T12:00:00`); // mediodía: sin saltos de día por zona horaria
  const nombreDia = (d: string) => DIAS[fecha(d).getDay()];
  const titulo = (d: string) => `${nombreDia(d)} ${Number(d.slice(8))} de ${MESES[Number(d.slice(5, 7)) - 1]}`;
  const mayus = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  // ————— Paso 2: calendario propio —————

  async function cargarMes(nuevo: string, { elegirPrimero = true } = {}) {
    const d = datos(actual)!;
    mes = nuevo;
    horarios = {};
    const yo = ++peticion;
    pintarMes(true);
    pintarHoras();
    try {
      const h = await horariosDelMes(d.evento!, mes);
      if (yo !== peticion) return;
      horarios = h;
      const dias = Object.keys(horarios).sort();
      if (elegirPrimero) {
        // Si en lo que queda del mes ya no hay horarios, se pasa al siguiente.
        if (!dias.length && mes < mesSiguiente(hoy().slice(0, 7), MESES_ADELANTE) && mes === hoy().slice(0, 7)) {
          return cargarMes(mesSiguiente(mes));
        }
        dia = dias[0] ?? null;
        hora = null;
      }
      pintarMes(false);
      pintarHoras();
    } catch (e) {
      console.warn('[reservas] No se pudieron cargar los horarios; se usa el calendario de Cal.com.', e);
      if (yo === peticion) respaldo();
    }
  }

  function pintarMes(cargando: boolean) {
    const [a, m] = mes.split('-').map(Number);
    $('mesLbl').textContent = `${MESES[m - 1]} ${a}`;
    const actualMes = hoy().slice(0, 7);
    ($('mesAnt') as HTMLButtonElement).disabled = mes <= actualMes;
    ($('mesSig') as HTMLButtonElement).disabled = mes >= mesSiguiente(actualMes, MESES_ADELANTE);
    const primero = new Date(Date.UTC(a, m - 1, 1)).getUTCDay();
    const huecos = (primero + 6) % 7; // la semana empieza en lunes
    const total = new Date(Date.UTC(a, m, 0)).getUTCDate();
    let html = '<span class="pad"></span>'.repeat(huecos);
    for (let n = 1; n <= total; n++) {
      const d = `${mes}-${String(n).padStart(2, '0')}`;
      const libre = !cargando && !!horarios[d];
      const elegido = libre && d === dia;
      html += `<button type="button" data-dia="${d}" ${libre ? '' : 'disabled'} aria-pressed="${elegido}"
        aria-label="${titulo(d)}${libre ? '' : ', sin horarios'}">${n}</button>`;
    }
    $('dias').innerHTML = html;
    $('dias').classList.toggle('cargando', cargando);
  }

  function pintarHoras() {
    const lista = dia ? horarios[dia] ?? [] : [];
    $('lbl-hora').textContent = dia ? `Hora · ${nombreDia(dia).slice(0, 3)} ${Number(dia.slice(8))}` : 'Hora';
    $('horas').innerHTML = lista
      .map((iso) => `<button type="button" data-hora="${iso}" aria-pressed="${iso === hora}">${horaLocal(iso)}</button>`)
      .join('');
    const cargando = $('dias').classList.contains('cargando');
    $('horasAviso').textContent = cargando
      ? 'Cargando horarios disponibles…'
      : !Object.keys(horarios).length
        ? 'No hay horarios disponibles este mes. Prueba el siguiente.'
        : dia ? '' : 'Elige un día.';
    const d = datos(actual)!;
    $('resSvc').textContent = d.nombre!;
    $('resDur').textContent = d.duracion!;
    $('resPrecio').textContent = `$${d.precio} MXN`;
    $('resCuando').textContent = dia && hora ? `${mayus(titulo(dia))}, ${horaLocal(hora)} h` : 'Elige un día y una hora';
    ($('continuar') as HTMLButtonElement).disabled = !(dia && hora);
  }

  // ————— Paso 3: tus datos —————

  type Paso = 'agenda' | 'datos' | 'exito' | 'cal';
  const TITULOS: Record<Paso, string> = { agenda: 'Elige día y hora', datos: 'Tus datos', exito: 'Reserva confirmada', cal: 'Elige día y hora' };

  function vista(paso: Paso) {
    agenda!.hidden = paso !== 'agenda';
    $('datos').hidden = paso !== 'datos';
    $('exito').hidden = paso !== 'exito';
    embed!.hidden = paso !== 'cal';
    if (paso !== 'cal') embed!.replaceChildren();
    $('reiniciar').hidden = paso !== 'datos';
    $('paso2-t').textContent = TITULOS[paso];
  }

  const cuando = () => (dia && hora ? `${mayus(titulo(dia))}, ${horaLocal(hora)} h` : '');

  function continuar() {
    if (!dia || !hora) return;
    const d = datos(actual)!;
    $('dSvc').textContent = d.nombre!;
    $('dCuando').textContent = cuando();
    $('dDur').textContent = d.duracion!;
    $('dPrecio').textContent = `$${d.precio} MXN`;
    $('fError').hidden = true;
    vista('datos');
    book.scrollIntoView({ behavior: suave(), block: 'start' });
    ($('fNombre') as HTMLInputElement).focus({ preventScroll: true });
  }

  const soloDigitos = (v: string) => v.replace(/\D/g, '').replace(/^52(?=\d{10}$)/, '');

  function mostrarError(msg: string, campo?: string) {
    const e = $('fError');
    e.textContent = msg;
    e.hidden = false;
    if (campo) ($(campo) as HTMLInputElement).focus();
  }

  async function enviar(ev: SubmitEvent) {
    ev.preventDefault();
    if (!dia || !hora) return;
    const nombre = ($('fNombre') as HTMLInputElement).value.trim();
    const correo = ($('fCorreo') as HTMLInputElement).value.trim();
    const tel = soloDigitos(($('fTel') as HTMLInputElement).value);
    const notas = ($('fNotas') as HTMLTextAreaElement).value.trim();
    if (nombre.length < 2) return mostrarError('Escribe tu nombre.', 'fNombre');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo)) return mostrarError('Revisa tu correo electrónico: ahí te llega la confirmación.', 'fCorreo');
    if (tel && tel.length !== 10) return mostrarError('El WhatsApp debe tener 10 dígitos (o déjalo vacío).', 'fTel');

    const d = datos(actual)!;
    const boton = $('confirmar') as HTMLButtonElement;
    boton.disabled = true;
    boton.textContent = 'Confirmando…';
    $('fError').hidden = true;

    // Si un bot llenó el campo trampa, se finge el éxito sin reservar nada.
    const bot = ($('fSitio') as HTMLInputElement).value !== '';
    const r = bot ? { ok: true as const } : await crearReserva({ evento: d.evento!, inicio: hora, nombre, correo, telefono: tel || undefined, notas: notas || undefined });

    boton.disabled = false;
    boton.textContent = 'Confirmar reserva';
    if (r.ok) {
      olvidar(d.evento!); // esa hora ya no está libre
      $('eTitulo').textContent = `¡Listo, ${nombre.split(' ')[0]}! Tu cita quedó reservada`;
      $('eCuando').textContent = `${d.nombre} · ${cuando()} · ${d.duracion} · $${d.precio} MXN`;
      $('eCorreo').textContent = `Te enviamos la confirmación a ${correo}. Desde ese correo puedes cambiar o cancelar tu cita.`;
      ($('datos') as HTMLFormElement).reset();
      vista('exito');
      book.scrollIntoView({ behavior: suave(), block: 'start' });
      $('exito').focus({ preventScroll: true });
      return;
    }
    if (r.motivo === 'ocupada') {
      olvidar(d.evento!);
      hora = null;
      vista('agenda');
      await cargarMes(mes, { elegirPrimero: false });
      $('horasAviso').textContent = 'Esa hora se acaba de ocupar. Elige otra, por favor.';
      return;
    }
    const mensajes = {
      limite: 'Ya tienes el máximo de citas activas con este correo. Si necesitas otra, escríbenos por WhatsApp.',
      datos: 'Cal.com no aceptó los datos. Revisa tu nombre y correo, o escríbenos por WhatsApp.',
      red: 'No pudimos conectar para confirmar tu reserva. Revisa tu internet e intenta de nuevo.',
      otro: 'No pudimos confirmar tu reserva. Intenta de nuevo o escríbenos por WhatsApp.',
    } as const;
    mostrarError(mensajes[r.motivo]);
  }

  /** Respaldo: si la API de horarios no responde, el calendario completo de Cal.com. */
  function respaldo() {
    const d = datos(actual)!;
    vista('cal');
    const aviso = document.createElement('p');
    aviso.className = 'cal-loading';
    aviso.textContent = 'Cargando horarios disponibles…';
    const el = document.createElement('div');
    el.className = 'cal-frame';
    embed!.append(aviso, el);
    montarCalendario(el, { origin, calLink: d.evento!, namespace: `svc_${actual.replace(/-/g, '_')}_${++montajes}` });
    // Cal.com inserta su iframe: se quita el aviso y se le pone un título en español ("Book a call" por defecto).
    const listo = () => {
      const iframe = el.querySelector('iframe');
      if (!iframe) return false;
      iframe.title = `Calendario para reservar: ${d.nombre}`;
      aviso.remove();
      return true;
    };
    if (!listo()) new MutationObserver((_, obs) => { if (listo()) obs.disconnect(); }).observe(el, { childList: true, subtree: true });
  }

  // ————— Navegación entre pasos —————

  /** Paso 2: oculta las tarjetas y muestra la agenda (o WhatsApp) del servicio elegido. */
  function elegir(id: string) {
    const d = datos(id);
    if (!d) return;
    actual = id;
    $('sumSvc').textContent = d.nombre!;
    $('sumDur').textContent = d.duracion!;
    $('sumPrice').textContent = `$${d.precio} MXN`;
    if (conCal) {
      vista('agenda');
      dia = null;
      hora = null;
      cargarMes(hoy().slice(0, 7));
    } else {
      $('waSvc').textContent = d.nombre!;
      const msg = `Hola, quiero agendar una cita para: ${d.nombre} ($${d.precio} MXN).`;
      ($('waBtn') as HTMLAnchorElement).href = `${book.dataset.wa}?text=${encodeURIComponent(msg)}`;
    }
    paso1.hidden = true;
    book.hidden = false;
    // Lleva al panel (no al inicio de la sección) para ver el calendario y las horas completos.
    book.scrollIntoView({ behavior: suave(), block: 'start' });
    $('paso2-t').focus({ preventScroll: true });
  }

  /** Vuelve a las tarjetas. */
  function cambiar() {
    book.hidden = true;
    paso1.hidden = false;
    if (conCal) vista('agenda');
    window.dispatchEvent(new CustomEvent('mamba:cambiar', { detail: actual }));
  }

  /** "Cambiar horario": de vuelta a la agenda, con el día y la hora que tenía. */
  function reiniciar() {
    vista('agenda');
    pintarMes(false);
    pintarHoras();
    $('paso2-t').focus();
  }

  /** "Hacer otra reserva": agenda del mismo servicio con horarios actualizados. */
  function otra() {
    dia = null;
    hora = null;
    vista('agenda');
    cargarMes(hoy().slice(0, 7));
    $('paso2-t').focus();
  }

  // Botón "Reservar" de cada tarjeta. Sin JavaScript, el enlace abre Cal.com o WhatsApp directamente.
  picks.forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); elegir(a.dataset.pick!); }));
  $('cambiar').addEventListener('click', cambiar);

  if (conCal) {
    $('reiniciar').addEventListener('click', reiniciar);
    $('otra').addEventListener('click', otra);
    ($('datos') as HTMLFormElement).addEventListener('submit', enviar);
    $('continuar').addEventListener('click', continuar);
    $('mesAnt').addEventListener('click', () => { dia = null; hora = null; cargarMes(mesSiguiente(mes, -1)); });
    $('mesSig').addEventListener('click', () => { dia = null; hora = null; cargarMes(mesSiguiente(mes)); });
    $('dias').addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-dia]');
      if (!b || b.disabled) return;
      dia = b.dataset.dia!;
      hora = null;
      pintarMes(false);
      pintarHoras();
    });
    $('horas').addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-hora]');
      if (!b) return;
      hora = b.dataset.hora!;
      pintarHoras();
      $('horas').querySelector<HTMLButtonElement>(`[data-hora="${hora}"]`)?.focus();
    });

    // Al acercarse a la sección se abre la conexión con Cal.com para que todo responda rápido.
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((en) => en.isIntersecting)) return;
      for (const href of [origin, 'https://api.cal.com']) {
        const link = document.createElement('link');
        link.rel = 'preconnect';
        link.href = href;
        link.crossOrigin = '';
        document.head.appendChild(link);
      }
      io.disconnect();
    }, { rootMargin: '600px 0px' });
    io.observe(paso1);
  }

  // Enlace directo con servicio: /?servicio=permacologia#reservar (útil para Instagram).
  const deUrl = new URLSearchParams(location.search).get('servicio');
  if (deUrl && datos(deUrl)) elegir(deUrl);
</script>

<style>
  .book {
    border: 1px solid var(--color-line-2); border-radius: 10px; background: var(--color-bg); padding: 28px;
    /* Con el scroll-padding global (96 px), el panel queda ~24 px debajo del encabezado compacto. */
    scroll-margin-top: -8px;
  }
  .book:not([hidden]) { animation: pasoIn .35s var(--ease) both; }
  @keyframes pasoIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .step {
    font-size: 13px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    color: var(--color-muted); margin: 0 0 8px; display: block; outline: none;
  }

  .elegido {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
    padding-bottom: 20px; margin-bottom: 0; border-bottom: 1px solid var(--color-line);
  }
  .elegido-txt { display: flex; flex-direction: column; gap: 2px; color: var(--color-body); font-size: 15px; }
  .elegido-txt strong { font-family: var(--font-display); font-weight: 400; font-size: 29px; letter-spacing: .02em; text-transform: uppercase; line-height: 1; color: var(--color-fg); }
  .elegido-txt .p { color: var(--color-fg); font-weight: 600; }
  .acciones { display: flex; flex-wrap: wrap; gap: 10px; }
