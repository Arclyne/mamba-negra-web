---
import { getServicios, duracionTexto } from '../lib/servicios';
import BgTool from './BgTool.astro';
import Reservar from './Reservar.astro';
import SectionTitle from './SectionTitle.astro';
import { negocio, waLink } from '../config/negocio';

// Una sola sección para ver servicios y reservar: las tarjetas son el paso 1 y, al pulsar
// "Reservar", se cambian por el calendario de ese servicio (paso 2, Reservar.astro).
const todos = await getServicios();
const grupos = [
  { id: 'servicios', etiqueta: 'Servicios', items: todos.filter((s) => s.data.categoria === 'servicio') },
  { id: 'combos', etiqueta: 'Combos', items: todos.filter((s) => s.data.categoria === 'combo') },
];
const { usuario } = negocio.calcom;
const conCal = usuario.trim() !== '';
const evento = (id: string, calEvento?: string) => `${usuario}/${calEvento ?? id}`;
// Destino sin JavaScript: la página de Cal.com del servicio, o WhatsApp con el servicio escrito.
const sinJs = (id: string, nombre: string, precio: number, calEvento?: string) =>
  conCal ? `https://cal.com/${evento(id, calEvento)}` : waLink(`Hola, quiero agendar una cita para: ${nombre} ($${precio} MXN).`);
---

<section class="section alt" id="servicios" aria-labelledby="t-servicios">
  <span id="reservar" class="ancla" aria-hidden="true"></span>
  <BgTool tool="clipper" class="bt-serv" />
  <div class="wrap">
    <div class="sec-head">
      <div>
        <SectionTitle eyebrow="Servicios y reservas" id="t-servicios">Lo que hacemos</SectionTitle>
        <p class="intro">
          {conCal
            ? 'Elige tu servicio y reserva en línea. Te llega la confirmación por correo y un recordatorio un día antes.'
            : 'Elige tu servicio y agenda por WhatsApp.'}
        </p>
      </div>
      <div class="tabs" role="tablist" aria-label="Tipo de servicio">
        <span class="ind" aria-hidden="true"></span>
        {grupos.map((g, i) => (
          <button type="button" role="tab" id={`tab-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${g.id}`} tabindex={i === 0 ? 0 : -1}>{g.etiqueta}</button>
        ))}
      </div>
    </div>

    <div id="paso1">
    {grupos.map((g, i) => (
      <div class="cards" id={`panel-${g.id}`} role="tabpanel" aria-labelledby={`tab-${g.id}`} hidden={i !== 0}>
        {g.items.map((s, n) => (
          <article class="card" style={`--i:${n}`}>
            <div class="card-top">
              <h3>{s.data.nombre}</h3>
              <span class="price">${s.data.precio}</span>
            </div>
            <p>{s.data.descripcion}</p>
            <div class="card-foot">
              <div class="meta">
                <span><svg class="ico" aria-hidden="true"><use href="#i-clock" /></svg>{duracionTexto(s.data.duracion)}</span>
                {s.data.ahorro && <span class="save">Ahorras {s.data.ahorro}</span>}
              </div>
              <a class="btn btn-red" href={sinJs(s.id, s.data.nombre, s.data.precio, s.data.calEvento)}
                data-pick={s.id} data-nombre={s.data.nombre} data-precio={s.data.precio}
                data-duracion={duracionTexto(s.data.duracion)} data-evento={evento(s.id, s.data.calEvento)}
                aria-label={`Reservar ${s.data.nombre}`}>Reservar</a>
            </div>
          </article>
        ))}
      </div>
    ))}
    <p class="note">Precios en pesos mexicanos (MXN). Permacología requiere un largo mínimo de 4 dedos.</p>
    </div>

    <Reservar />

    {conCal && (
      <div class="rules">
        <span><svg class="ico" aria-hidden="true"><use href="#i-clock" /></svg>Reserva hasta 30 min antes</span>
        <span><svg class="ico" aria-hidden="true"><use href="#i-undo" /></svg>Cancela o cambia hasta 1 h antes, desde tu correo</span>
        <span><svg class="ico" aria-hidden="true"><use href="#i-mail" /></svg>Confirmación y recordatorio por correo</span>
      </div>
    )}
  </div>
</section>

<script>
  const tablist = document.querySelector<HTMLElement>('#servicios [role="tablist"]')!;
  const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const ind = tablist.querySelector<HTMLElement>('.ind')!;

  function moveInd() {
    const sel = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
    if (!sel || !sel.offsetWidth) return;
    tablist.classList.add('has-ind');
    ind.style.width = `${sel.offsetWidth}px`;
    ind.style.transform = `translateX(${sel.offsetLeft}px)`;
  }

  function play(panel: HTMLElement) {
    panel.classList.remove('play');
    void panel.offsetWidth;
    panel.classList.add('play');
  }

  function select(tab: HTMLButtonElement, focus = false) {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
    if (focus) tab.focus();
    moveInd();
    play(document.getElementById(tab.getAttribute('aria-controls')!)!);
  }

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      select(tabs[(i + d + tabs.length) % tabs.length], true);
    });
  });
  window.addEventListener('resize', moveInd);
  document.fonts?.ready.then(moveInd);
  moveInd();

  // Al volver del calendario ("Cambiar servicio"): se abre la pestaña de ese servicio y se enfoca su botón.
  window.addEventListener('mamba:cambiar', (e) => {
    const id = (e as CustomEvent<string>).detail;
    const boton = document.querySelector<HTMLElement>(`#servicios [data-pick="${id}"]`);
    const panel = boton?.closest<HTMLElement>('[role="tabpanel"]');
    const tab = panel && tabs.find((t) => t.getAttribute('aria-controls') === panel.id);
    if (tab && tab.getAttribute('aria-selected') !== 'true') select(tab);
    document.getElementById('servicios')!.scrollIntoView({ block: 'start' });
    boton?.focus({ preventScroll: true });
  });

  // Entrada escalonada de las tarjetas la primera vez que se ven.
  const first = document.getElementById('panel-servicios')!;
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { play(first); io.disconnect(); }
    }, { threshold: 0.1 });
    io.observe(first);
  }
</script>

<style>
  .ancla { position: absolute; top: 0; }
  .intro { margin: 16px 0 0; max-width: 30em; color: var(--color-body); }
  /* En el paso 2 las pestañas se ocultan, pero conservan su lugar para que el título no salte. */
  .sec-head:has(~ #paso1[hidden]) .tabs { visibility: hidden; }
  .rules { display: flex; flex-wrap: wrap; gap: 12px 40px; margin-top: 28px; font-size: 16px; color: var(--color-body); }
  .rules span { display: flex; align-items: center; gap: 10px; }
  .rules .ico { stroke: var(--color-red-text); }

  .tabs { position: relative; display: flex; gap: 6px; padding: 6px; background: var(--color-bg); border: 1px solid var(--color-line); border-radius: 6px; }
  .tabs button {
    position: relative; z-index: 1; min-height: 48px; padding: 0 26px; border: 0; border-radius: 4px;
    background: transparent; color: var(--color-body); font-weight: 700; font-size: 15px; letter-spacing: .1em;
    text-transform: uppercase; cursor: pointer; transition: color .25s;
  }
  .tabs button[aria-selected="true"] { background: var(--color-red); color: #fff; }
  .tabs.has-ind button[aria-selected="true"] { background: transparent; }
  .ind {
    position: absolute; top: 6px; bottom: 6px; left: 0; border-radius: 4px; background: var(--color-red);
    transition: transform .35s var(--ease), width .35s var(--ease); z-index: 0;
  }

  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .card {
    position: relative; overflow: hidden;
    background: var(--color-bg); border: 1px solid var(--color-line); border-radius: 8px; padding: 28px 32px;
    display: flex; flex-direction: column; gap: 10px;
    transition: border-color .2s, transform .25s var(--ease), box-shadow .25s;
  }
  .card > * { position: relative; z-index: 1; }
  .card:hover { border-color: var(--color-line-2); transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0, 0, 0, .55), 0 0 0 1px rgba(215, 38, 46, .35); }
  /* Al pasar el cursor la tarjeta se "desvanece" desde abajo, como un fade */
  .card::before {
    content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    transform-origin: bottom; transform: scaleY(0); transition: transform .45s var(--ease);
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, .035) 0 1px, transparent 1px 5px),
      linear-gradient(to top, rgba(215, 38, 46, .30) 0%, rgba(215, 38, 46, .12) 35%, transparent 75%);
    -webkit-mask-image: linear-gradient(to top, #000 20%, transparent 85%);
    mask-image: linear-gradient(to top, #000 20%, transparent 85%);
  }
  .card:hover::before { transform: scaleY(1); }
  .card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  h3 { font-family: var(--font-display); font-weight: 400; font-size: 34px; letter-spacing: .03em; line-height: 1; margin: 0; }
  .price { font-family: var(--font-display); font-size: 38px; line-height: 1; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .card p { margin: 0; color: var(--color-body); font-size: 16px; line-height: 1.55; flex: 1; }
  .card-foot {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding-top: 14px; margin-top: 4px; border-top: 1px solid #1c1c1f;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 15px; color: var(--color-soft); }
  .meta span { display: flex; align-items: center; gap: 6px; }
  .meta .ico { width: 16px; height: 16px; }
  .meta .save { color: #e4e4e8; }
  .card .btn { min-height: 44px; padding: 0 20px; font-size: 14px; }
  .note { margin: 20px 0 0; font-size: 15px; color: var(--color-soft); }

  .cards.play .card { animation: cardIn .55s var(--ease) both; animation-delay: calc(var(--i, 0) * 60ms); }
  :global(html.anim) #panel-servicios:not(.play) .card { opacity: 0; }
  @keyframes cardIn { from { opacity: 0; transform: translateY(22px) scale(.98); } to { opacity: 1; transform: none; } }

  section :global(.bt-serv) { width: clamp(180px, 17vw, 250px); right: 2%; top: 6%; transform: rotate(16deg); }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
    section :global(.bt-serv) { width: 44vw; right: -12%; top: 2%; }
  }
  @media (max-width: 640px) {
    .tabs { width: 100%; }
    .tabs button { flex: 1; padding: 0; }
    .card { padding: 20px; }
    h3 { font-size: 28px; }
    .price { font-size: 30px; }
    .rules { flex-direction: column; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.anim) #panel-servicios:not(.play) .card { opacity: 1; }
  }
</style>
