---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Strip from '../components/Strip.astro';
import Nosotros from '../components/Nosotros.astro';
import Servicios from '../components/Servicios.astro';
import Galeria from '../components/Galeria.astro';
import Resenas from '../components/Resenas.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Footer from '../components/Footer.astro';
---

<Base schema>
  <Header />
  <main id="contenido">
    <Hero />
    <Strip />
    <Nosotros />
    <Servicios />
    <Galeria />
    <Resenas />
    <Ubicacion />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/motion';
</script>
