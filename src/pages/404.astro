---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Página no encontrada · La Mamba Negra" noindex>
  <Header inicio="/" />
  <main id="contenido" class="wrap flex min-h-[60vh] flex-col items-start justify-center gap-6 py-24">
    <p class="eyebrow">Error 404</p>
    <h1 class="display text-[clamp(72px,12vw,140px)]">Aquí no hay <span class="text-red-hot">corte</span></h1>
    <p class="m-0 max-w-[32em] text-body">La página que buscas no existe o cambió de dirección.</p>
    <a class="btn btn-red" href="/">Volver al inicio</a>
  </main>
  <Footer inicio="/" />
</Base>
